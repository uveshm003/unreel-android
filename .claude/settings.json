{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(adb *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh repo delete *)",
      "Read(./local.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  }
}
